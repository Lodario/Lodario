# Public browser configuration. The anon key is intentionally public and must
# be protected by Supabase RLS; never place a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_supabase_anon_key
NEXT_PUBLIC_SITE_URL=https://lodario.vercel.app

# Public legal identity rendered into the Privacy Policy and Terms. Use the
# operator's full personal legal name; this value is not a secret.
LEGAL_OPERATOR_NAME=REPLACE_WITH_YOUR_FULL_LEGAL_NAME

# Server-only feedback email configuration. Never prefix these with NEXT_PUBLIC_.
GMAIL_SMTP_USER=contact.lodario@gmail.com
GMAIL_SMTP_APP_PASSWORD=your_gmail_app_password_here
FEEDBACK_EMAIL_TO=contact.lodario@gmail.com
EMAIL_FROM=Lodario Feedback <contact.lodario@gmail.com>
